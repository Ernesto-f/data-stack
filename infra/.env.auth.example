# Private identity-stack variables. Store actual values in infra/.env.auth (mode 600).
KC_DB_PASSWORD=replace_with_random_database_password
KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KC_BOOTSTRAP_ADMIN_PASSWORD=replace_with_random_keycloak_admin_password
KEYCLOAK_PORT=18083

OAUTH2_PROXY_CLIENT_ID=pulse-oauth2-proxy
OAUTH2_PROXY_CLIENT_SECRET=replace_after_creating_keycloak_client
OAUTH2_PROXY_COOKIE_SECRET=replace_with_32_byte_random_cookie_secret
OAUTH2_PROXY_PORT=4180

PAPERLESS_OIDC_CLIENT_ID=pulse-archive
PAPERLESS_OIDC_CLIENT_SECRET=replace_after_creating_keycloak_client
GRAFANA_OIDC_CLIENT_ID=pulse-analytics
GRAFANA_OIDC_CLIENT_SECRET=replace_after_creating_keycloak_client
SAMIA_OIDC_CLIENT_ID=pulse-samia
SAMIA_OIDC_CLIENT_SECRET=replace_after_creating_keycloak_client
AIRFLOW_OIDC_CLIENT_ID=pulse-automation
AIRFLOW_OIDC_CLIENT_SECRET=replace_after_creating_keycloak_client
ODOO_OIDC_CLIENT_ID=pulse-crm
ODOO_OIDC_CLIENT_SECRET=replace_after_creating_keycloak_client
