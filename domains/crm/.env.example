# Valores de referência para validar o Compose. O provisionador cria um .env por tenant.
CRM_TENANT_KEY=demo
CRM_PUBLIC_HOST=crm.izatacore.com
CRM_ODOO_PORT=18095
CRM_DB_NAME=pulse_crm_demo
CRM_DB_USER=pulse_crm_demo
CRM_DB_PASSWORD=replace_with_random_database_password
CRM_MASTER_PASSWORD=replace_with_random_odoo_master_password
CRM_INITIAL_ADMIN_PASSWORD=replace_with_random_odoo_admin_password
CRM_OIDC_CLIENT_ID=pulse-crm-demo
CRM_OIDC_CLIENT_SECRET=replace_with_random_keycloak_client_secret
CRM_ODOO_CONFIG=./config/odoo.conf.example
