# Generate new secrets for this VPS instance. Keep the real .env untracked.
PAPERLESS_DB_PASSWORD=replace_with_random_database_password
PAPERLESS_SECRET_KEY=replace_with_random_secret_key
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=replace_with_random_admin_password
PAPERLESS_URL=https://archive.izatacore.com
PAPERLESS_TIME_ZONE=America/Sao_Paulo
PAPERLESS_OCR_LANGUAGES=por spa
PAPERLESS_OCR_LANGUAGE=por+spa+eng
PAPERLESS_PORT=18095
USERMAP_UID=1000
USERMAP_GID=1000

# OIDC client settings from the shared Keycloak realm.
PAPERLESS_APPS=allauth.socialaccount.providers.openid_connect
PAPERLESS_SOCIALACCOUNT_PROVIDERS='{"openid_connect":{"SCOPE":["openid","profile","email","groups"],"APPS":[{"provider_id":"pulse-archive","name":"Pulse Archive","client_id":"pulse-archive","secret":"replace_with_private_keycloak_client_secret","settings":{"server_url":"https://portal.izatacore.com/keylogin/realms/pulse","uid_field":"sub","fetch_userinfo":true,"oauth_pkce_enabled":true}}]}}'
PAPERLESS_SOCIAL_ACCOUNT_SYNC_GROUPS=true
PAPERLESS_SOCIAL_AUTO_SIGNUP=true
PAPERLESS_SOCIAL_ACCOUNT_ALLOW_SIGNUPS=true
# Keep password login available for the internal admin until SSO is verified.
PAPERLESS_DISABLE_REGULAR_LOGIN=false
