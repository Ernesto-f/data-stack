# Copy to .env on the VPS and replace secret placeholders before starting.
TZ=America/Sao_Paulo

# Demo/dev warehouse database
PG_DB=warehouse
PG_USER=warehouse
PG_PASSWORD=replace-with-a-random-password
DATA_PG_BIND=127.0.0.1
DATA_PG_PORT=15432

# MinIO object storage for collection outputs (Paperless remains separate)
MINIO_ROOT_USER=dataplatform
MINIO_ROOT_PASSWORD=replace-with-a-random-password
MINIO_BIND=127.0.0.1
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

# Airflow metadata and local demo/dev admin
AF_PG_PASSWORD=replace-with-a-random-password
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=replace-with-a-random-password
AIRFLOW_FERNET_KEY=replace-with-a-valid-urlsafe-base64-fernet-key
AIRFLOW_API_SECRET_KEY=replace-with-a-random-secret
AIRFLOW_JWT_SECRET=replace-with-a-random-secret
AIRFLOW_API_PORT=18082
AIRFLOW_PUBLIC_BASE_URL=https://automation.izatacore.com
AIRFLOW_PARALLELISM=4
AIRFLOW_UID=50000
AIRFLOW_GID=0

# Local monitoring UI credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-random-password
GRAFANA_ROOT_URL=https://analytics.izatacore.com/
GRAFANA_OIDC_CLIENT_ID=pulse-analytics
GRAFANA_OIDC_CLIENT_SECRET=replace-with-keycloak-client-secret
AIRFLOW_OIDC_CLIENT_ID=pulse-automation
AIRFLOW_OIDC_CLIENT_SECRET=replace-with-keycloak-client-secret

# Read-only account used by Grafana to query the WeKnora reporting views.
GRAFANA_WEKNORA_DB_PASSWORD=replace-with-a-random-password

# One unique read-only postgres_exporter password per PostgreSQL instance.
PG_EXPORTER_WAREHOUSE_PASSWORD=replace-with-a-random-password
PG_EXPORTER_AIRFLOW_PASSWORD=replace-with-a-random-password
PG_EXPORTER_WEKNORA_PASSWORD=replace-with-a-random-password
PG_EXPORTER_ARCHIVE_PASSWORD=replace-with-a-random-password
PG_EXPORTER_SALUS_ERP_PASSWORD=replace-with-a-random-password
PG_EXPORTER_SALUS_LIMS_PASSWORD=replace-with-a-random-password
PG_EXPORTER_TRACCAR_PASSWORD=replace-with-a-random-password
PG_SLOW_QUERY_THRESHOLD_SECONDS=180
